{
  "name": "unjustified",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test src/*.test.ts",
    "test:e2e": "playwright test",
    "bench": "tsx bench/run.ts",
    "bench:search": "tsx bench/optimizer-bench.ts",
    "test:production": "pnpm build && playwright test --config=playwright.production.config.ts",
    "build:wasm": "cd wasm && RUSTFLAGS='-C target-feature=+simd128' cargo build --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/unjustified_search.wasm ../src/kernel/search.wasm"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.2.0",
    "hyphen": "^1.14.1",
    "linebreak": "^1.1.0"
  }
}
